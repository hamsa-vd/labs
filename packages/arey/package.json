{
  "name": "@hamsa-designs/arey",
  "version": "1.0.1",
  "description": "The Arey design system: tokens, styles, assets, React components, and agent guidance.",
  "type": "module",
  "sideEffects": [
    "./styles.css",
    "./tokens/*.css"
  ],
  "files": [
    "assets",
    "agents",
    "components",
    "guidelines",
    "tokens",
    "ui_kits",
    "readme.md",
    "hamsa-design.json",
    "SKILL.md",
    "styles.css"
  ],
  "exports": {
    "./styles.css": "./styles.css",
    "./react": {
      "types": "./components/index.d.ts",
      "default": "./components/index.jsx"
    },
    "./tokens/*": "./tokens/*",
    "./assets/*": "./assets/*",
    "./manifest": "./hamsa-design.json",
    "./guidelines": "./readme.md",
    "./skill": "./SKILL.md"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/hamsa-vd/hamsa-designs.git",
    "directory": "packages/arey"
  }
}
