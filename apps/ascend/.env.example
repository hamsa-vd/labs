APP_ENV=development
APP_ORIGIN=http://localhost:3000

DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Access protects (authenticated). The (public) routes bypass it.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUDIENCE=
# Turnstile guards the only unauthenticated write, POST /api/v1/invite-requests.
CLOUDFLARE_TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/oauth/gmail/callback

# 32 bytes, base64. Held on the Mac Mini, never in Supabase.
TOKEN_ENCRYPTION_KEY=

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Bump to re-derive every status from the event history. Nothing is migrated.
PROMPT_VERSION=1
# Extractions below this go to Needs review instead of creating an event.
EXTRACTION_CONFIDENCE_FLOOR=0.7
# Anchor for resolving relative dates such as "within 5 days" or "Friday 10:30".
DEFAULT_TIMEZONE=Europe/London

# Seats are capped while this runs on one Mac Mini.
INVITE_SEAT_LIMIT=15
