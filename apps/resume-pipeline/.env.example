# Resume pipeline configuration. Copy to .env and fill in. Every variable without a default is
# required: the service refuses to start rather than failing later on a request.

# Postgres the pipeline shares with ascend. Required.
RESUME_DATABASE_URL=postgres://ascend:ascend@127.0.0.1:55432/ascend

# Shared secret ascend presents as `Authorization: Bearer <token>`. Required; generate with
# `openssl rand -hex 32` and set the same value in ascend.
RESUME_SERVICE_TOKEN=

# Blob root for generated documents. Required; must be writable and outside the repository.
RESUME_DOCUMENTS_DIR=./var/documents

# HMAC key for signed document URLs. Required; generate with `openssl rand -hex 32`.
RESUME_DOCUMENT_URL_SECRET=

# Base64-encoded 32 bytes wrapping every stored provider key. Required; generate with
# `openssl rand -base64 32`. Rotating it makes every stored key unreadable.
RESUME_MASTER_KEY=

# Containerised Tectonic compiler. Optional; defaults to http://127.0.0.1:58080.
RESUME_LATEX_SERVICE_URL=http://127.0.0.1:58080

# `fake` or `live`. Optional; defaults to fake so no process can spend a user's money by omission.
RESUME_LLM_MODE=fake

# Optional; defaults to info. One of debug, info, warning, error, critical.
RESUME_LOG_LEVEL=info

# `development` or `production`. Optional; defaults to development.
RESUME_ENVIRONMENT=development
